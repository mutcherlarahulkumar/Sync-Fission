# PostgreSQL connection string
DATABASE_URL=postgresql://username:password@host:5432/syncfission

# JWT secret key - use a long random string in production
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Google Gemini API key - get from https://ai.google.dev/
# Used for both the assistant and for embedding study material.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Redis - powers rate limiting and the assistant's multi-turn memory.
# Optional: without it the API still runs, unthrottled and forgetful.
REDIS_URL=redis://localhost:6379

# ChromaDB - vector store for the RAG pipeline over tutor material.
# Optional: without it the assistant answers from general knowledge only.
CHROMA_URL=http://localhost:8000

# Server port (optional, defaults to 3000)
PORT=3000
