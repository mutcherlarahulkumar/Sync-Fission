# ── required ─────────────────────────────────────────────────────────────────
# The app refuses to start if either of these is missing or too weak.

# PostgreSQL connection string.
# Managed providers (Neon, Supabase, Render) usually need ?sslmode=require
DATABASE_URL=postgresql://username:password@host:5432/syncfission

# JWT signing key. At least 32 characters in production.
# Generate one: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string_of_at_least_32_characters

# ── required in production ───────────────────────────────────────────────────
# Comma-separated browser origins allowed to call this API. No wildcards:
# an API that answers "*" lets any page on the internet spend a token it
# found in a victim's browser.
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# development | production | test
NODE_ENV=development

# ── optional: each one that is missing disables a feature, not the app ────────

# Google Gemini. Powers the assistant and embeds study material.
# Without it, /api/v1/chat returns 503 and the rest of the app is unaffected.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Redis. Rate limiting and the assistant's multi-turn memory.
# Without it, requests are not throttled and the assistant forgets each message.
REDIS_URL=redis://localhost:6379

# ChromaDB. The vector store behind retrieval over tutor material.
# Without it, the assistant answers from general knowledge and says so.
CHROMA_URL=http://localhost:8000

# ── tuning ───────────────────────────────────────────────────────────────────
PORT=3000

# Connections per instance. Keep it small on serverless, where many instances
# share one database.
PG_POOL_MAX=5

# Only set this if your Postgres provider serves a self-signed certificate.
# It disables certificate verification, so it also disables MITM protection.
# DATABASE_SSL_NO_VERIFY=true
